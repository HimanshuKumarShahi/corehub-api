{
  "name": "corehub_api",
  "version": "1.0.0",
  "description": "Modular plug-and-play production-ready backend engine for rapid frontend prototyping and hackathons",
  "keywords": [
    "API",
    "Backend_API",
    "Docker",
    "Auth",
    "express",
    "modular",
    "docker",
    "hackathon",
    "backend",
    "auth",
    "banking",
    "jobs",
    "library",
    "open-source"
  ],
  "license": "ISC",
  "author": "Himanshu Kumar Shahi",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon -r dotenv/config src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.{js,json,md}\"",
    "prepare": "husky",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HimanshuKumarShahi/corehub-api.git"
  },
  "bugs": {
    "url": "https://github.com/HimanshuKumarShahi/corehub-api/issues"
  },
  "homepage": "https://github.com/HimanshuKumarShahi/corehub-api#readme",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "husky": "^9.1.7",
    "jsonwebtoken": "^9.0.3",
    "mailgen": "^2.0.36",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "dotenv": "^18.0.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
