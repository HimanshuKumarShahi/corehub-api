PORT=8000
CORS_ORIGIN=*
# Use frontend URl here

# Select which database engine to run: "mongo" or "postgres"

# COMPOSE_PROFILES=mongo
# ACTIVE_DB=mongo

ACTIVE_DB=postgres
COMPOSE_PROFILES=postgres,postgres-gui

# MONGODB URLS
# Use this for local Docker: mongodb://mongo:27017/corehub
# Use this for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/corehub?retryWrites=true&w=majority

MONGO_URI=mongodb://localhost:27017/corehub

# -----------------------------------------
# POSTGRESQL URLS
# Use this for local Docker: postgresql://postgres:password@postgres:5432/corehub
# Use this for external Postgres (AWS RDS / Supabase): postgresql://<user>:<password>@<host>:5432/<dbname>

POSTGRES_URI=postgresql://postgres:password@localhost:5432/corehub