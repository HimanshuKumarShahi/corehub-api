PORT=8000
CORS_ORIGIN=*
# Use frontend URl here

NODE_ENV=production

# MONGODB URLS
# Use this for local Docker: mongodb://mongo:27017/corehub
# Use this for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/corehub?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/corehub

ACCESS_TOKEN_SECRET=giveaccesstoken
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=giverefreshtoken
REFRESH_TOKEN_EXPIRY=10d


MAILTRAP_SMPT_HOST=hostname
MAILTRAP_SMPT_PORT=2525 || 456
MAILTRAP_SMPT_USER=username
MAILTRAP_SMPT_PASS=password